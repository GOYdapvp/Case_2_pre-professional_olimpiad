class Application(tk.Frame):
    def __init__(self, master=None):
        super().__init__(master)
        self.master = master
        self.pack()
        self.create_widgets()

    def create_widgets(self):
        self.url_label = tk.Label(self)
        self.url_label["text"] = "URL сервиса:"
        self.url_label.pack(side="top")

        self.url_entry = tk.Entry(self)
        self.url_entry.pack(side="top")

        self.assemble_button = tk.Button(self)
        self.assemble_button["text"] = "Собрать карту"
        self.assemble_button["command"] = self.assemble_map
        self.assemble_button.pack(side="top")

        self.show_modules_button = tk.Button(self)
        self.show_modules_button["text"] = "Показать исследовательские модули"
        self.show_modules_button["command"] = self.show_modules
        self.show_modules_button.pack(side="top")

        self.show_stations_button = tk.Button(self)
        self.show_stations_button["text"] = "Показать базовые станции"
        self.show_stations_button["command"] = self.show_stations
        self.show_stations_button.pack(side="top")

        self.show_stats_button = tk.Button(self)
        self.show_stats_button["text"] = "Показать статистику станций"
        self.show_stats_button["command"] = self.show_station_stats
        self.show_stats_button.pack(side="top")

        self.quit = tk.Button(self, text="QUIT", fg="red",
                              command=self.master.destroy)
        self.quit.pack(side="bottom")

    def assemble_map(self):
        url = self.url_entry.get()
        map_data = assemble_map(url)
        plt.imshow(map_data, cmap='gray')
        plt.show()

    def show_modules(self):
        url = self.url_entry.get()
        map_data = assemble_map(url)
        peaks = find_peaks(map_data)
        plt.imshow(map_data, cmap='gray')
        for peak in peaks:
            plt.plot(peak[1], peak[0], 'go')
        plt.show()

    def show_stations(self):
        url = self.url_entry.get()
        map_data = assemble_map(url)
        peaks = find_peaks(map_data)
        stations = place_stations(peaks)
        plt.imshow(map_data, cmap='gray')
        colors = {'Купер': 'blue', 'Энгель': 'red'}
        
        for station in stations:
            x, y = station['location']
            color = colors[station['type']]

            plt.plot(y, x, marker='o', markersize=5, color=color)

            if station['type'] == 'Купер':
                radius = 32
            else:
                radius = 63
            
            circle = plt.Circle((y, x), radius, edgecolor=color, facecolor=color, alpha=0.2)
            plt.gca().add_artist(circle)
        
        plt.show()

    def show_station_stats(self):
        url = self.url_entry.get()
        map_data = assemble_map(url)
        peaks = find_peaks(map_data)
        stations = place_stations(peaks)
        
        coop_count = sum(1 for station in stations if station['type'] == 'Купер')
        engel_count = sum(1 for station in stations if station['type'] == 'Энгель')
        
        coop_cost = coop_count * 10
        engel_cost = engel_count * 20
        total_cost = coop_cost + engel_cost
        
        stats_text = f"Купер: {coop_count}\nЭнгель: {engel_count}\nОбщая стоимость: {total_cost} байткоинов"
        messagebox.showinfo("Статистика станций", stats_text)

root = tk.Tk()
app = Application(master=root)
app.mainloop()
