import numpy as np

def assemble_tiles(tiles):
    tile_size = 64
    map_size = 256
    assembled_map = np.zeros((map_size, map_size), dtype=int)

    # Расположение тайлов в правильном порядке
    for i, tile in enumerate(tiles):
        x = i % 4
        y = i // 4
        assembled_map[y*tile_size:(y+1)*tile_size, x*tile_size:(x+1)*tile_size] = tile

    return assembled_map

# Пример тайлов (16 тайлов размера 64x64, заполненных случайными значениями для демонстрации)
tiles = [np.random.randint(0, 256, (64, 64)) for _ in range(16)]

# Собрать тайлы в карту
assembled_map = assemble_tiles(tiles)

# Визуализация собранной карты
import matplotlib.pyplot as plt
plt.imshow(assembled_map, cmap='gray')
plt.show()
